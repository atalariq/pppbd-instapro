<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="8dp"
    android:paddingTop="12dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textStyle="bold"
        android:textSize="28sp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Profile picture -->
    <ImageView
        android:id="@+id/ivProfilePicture"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/pp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:background="@drawable/bg_circle"
        android:contentDescription="Profile picture"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Username -->
    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/user_name"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/ivProfilePicture"
        app:layout_constraintStart_toEndOf="@id/ivProfilePicture"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Stats: 3 TextView digabung angka+label jadi satu (hemat 3 view + 1 layout) -->
    <TextView
        android:id="@+id/tvStatsPosts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1\npost"
        app:layout_constraintTop_toBottomOf="@id/tvUsername"
        app:layout_constraintStart_toEndOf="@id/ivProfilePicture"
        app:layout_constraintEnd_toStartOf="@id/tvStatsFollowers"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/tvStatsFollowers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="434\nfollowers"
        app:layout_constraintTop_toTopOf="@id/tvStatsPosts"
        app:layout_constraintStart_toEndOf="@id/tvStatsPosts"
        app:layout_constraintEnd_toStartOf="@id/tvStatsFollowing"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/tvStatsFollowing"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="728\nfollowing"
        app:layout_constraintTop_toTopOf="@id/tvStatsPosts"
        app:layout_constraintStart_toEndOf="@id/tvStatsFollowers"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Name + bio -->
    <TextView
        android:id="@+id/tvFullName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/full_name"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivProfilePicture"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPronoun"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/pronoun"
        android:textColor="#8E8E8E"
        app:layout_constraintTop_toTopOf="@id/tvFullName"
        app:layout_constraintStart_toEndOf="@id/tvFullName" />

    <TextView
        android:id="@+id/tvBio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/bio"
        app:layout_constraintTop_toBottomOf="@id/tvFullName"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivLinkIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_link"
        android:contentDescription="Profile picture"
        app:layout_constraintTop_toBottomOf="@id/tvBio"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/tvBioLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/social_link"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/ivLinkIcon"
        app:layout_constraintStart_toEndOf="@id/ivLinkIcon"
        />

    <!-- Buttons -->
    <Button
        android:id="@+id/btnEditProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Edit Profile"
        android:textAllCaps="false"
        android:backgroundTint="#EFEFEF"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/tvBioLink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnShareProfile"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnShareProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Share Profile"
        android:textAllCaps="false"
        android:backgroundTint="#EFEFEF"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toTopOf="@id/btnEditProfile"
        app:layout_constraintStart_toEndOf="@id/btnEditProfile"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineV1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.333" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineV2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.666" />

    <!-- Row 1 -->
    <ImageView
        android:id="@+id/ivPost1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="1dp"
        android:background="#ACB"
        android:scaleType="centerCrop"
        android:contentDescription="Post 1"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintTop_toBottomOf="@id/btnEditProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineV1"
        tools:ignore="HardcodedText" />

    <ImageView
        android:id="@+id/ivPost2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="1dp"
        android:background="#CAB"
        android:scaleType="centerCrop"
        android:contentDescription="Post 2"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintTop_toTopOf="@id/ivPost1"
        app:layout_constraintStart_toEndOf="@id/guidelineV1"
        app:layout_constraintEnd_toStartOf="@id/guidelineV2"
        tools:ignore="HardcodedText" />

    <ImageView
        android:id="@+id/ivPost3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="1dp"
        android:background="#ABC"
        android:scaleType="centerCrop"
        android:contentDescription="Post 3"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintTop_toTopOf="@id/ivPost1"
        app:layout_constraintStart_toEndOf="@id/guidelineV2"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Row 2 -->
    <ImageView
        android:id="@+id/ivPost4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="1dp"
        android:background="#BAC"
        android:scaleType="centerCrop"
        android:contentDescription="Post 4"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintTop_toBottomOf="@id/ivPost1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineV1"
        tools:ignore="HardcodedText" />

    <ImageView
        android:id="@+id/ivPost5"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="1dp"
        android:background="#CBA"
        android:scaleType="centerCrop"
        android:contentDescription="Post 5"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintTop_toTopOf="@id/ivPost4"
        app:layout_constraintStart_toEndOf="@id/guidelineV1"
        app:layout_constraintEnd_toStartOf="@id/guidelineV2"
        tools:ignore="HardcodedText" />

    <ImageView
        android:id="@+id/ivPost6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="1dp"
        android:background="#BCA"
        android:scaleType="centerCrop"
        android:contentDescription="Post 6"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintTop_toTopOf="@id/ivPost4"
        app:layout_constraintStart_toEndOf="@id/guidelineV2"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Row 2 -->
    <ImageView
        android:id="@+id/ivPost7"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="1dp"
        android:background="#CAA"
        android:scaleType="centerCrop"
        android:contentDescription="Post 7"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintTop_toBottomOf="@id/ivPost4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineV1"
        tools:ignore="HardcodedText" />

    <ImageView
        android:id="@+id/ivPost8"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="1dp"
        android:background="#ABB"
        android:scaleType="centerCrop"
        android:contentDescription="Post 8"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintTop_toTopOf="@id/ivPost7"
        app:layout_constraintStart_toEndOf="@id/guidelineV1"
        app:layout_constraintEnd_toStartOf="@id/guidelineV2"
        tools:ignore="HardcodedText" />

    <ImageView
        android:id="@+id/ivPost9"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="1dp"
        android:background="#AAC"
        android:scaleType="centerCrop"
        android:contentDescription="Post 9"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintTop_toTopOf="@id/ivPost7"
        app:layout_constraintStart_toEndOf="@id/guidelineV2"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>